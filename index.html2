<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Ashraf Abdalla | Academic Portfolio</title>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">
<style>
*{margin:0;padding:0;box-sizing:border-box;font-family:'Poppins',sans-serif;}
body{
background:linear-gradient(135deg,#0f2027,#203a43,#2c5364);
color:white;
scroll-behavior:smooth;
}
section{
padding:90px 10%;
opacity:0;
transform:translateY(40px);
transition:1s;
}
section.active{
opacity:1;
transform:translateY(0);
}
header{
height:100vh;
display:flex;
flex-direction:column;
justify-content:center;
align-items:center;
text-align:center;
}
header img{
width:200px;
height:200px;
border-radius:50%;
border:5px solid #00f2fe;
object-fit:cover;
margin-bottom:25px;
box-shadow:0 0 40px rgba(0,242,254,0.7);
}
h1{font-size:3.2rem;}
h2{
margin-bottom:40px;
font-size:2.2rem;
border-bottom:2px solid #00f2fe;
display:inline-block;
padding-bottom:10px;
}
.card{
background:rgba(255,255,255,0.08);
backdrop-filter:blur(14px);
padding:35px;
border-radius:20px;
margin-bottom:30px;
transition:0.4s;
}
.card:hover{
transform:translateY(-10px);
background:rgba(255,255,255,0.15);
}
.grid{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(280px,1fr));
gap:25px;
}
.skill-bar{
background:#1c1c1c;
height:18px;
border-radius:10px;
overflow:hidden;
margin-top:6px;
}
.skill-fill{
height:100%;
background:linear-gradient(90deg,#00f2fe,#4facfe);
border-radius:10px;
}
.timeline{
border-left:3px solid #00f2fe;
padding-left:20px;
}
.timeline-item{
margin-bottom:25px;
}
.button{
display:inline-block;
padding:12px 28px;
background:linear-gradient(90deg,#00f2fe,#4facfe);
border-radius:30px;
color:#000;
font-weight:600;
margin-top:20px;
text-decoration:none;
transition:.3s;
}
.button:hover{transform:scale(1.05);}
.contact-buttons a{
display:inline-block;
margin:10px;
padding:12px 28px;
border-radius:50px;
background:linear-gradient(90deg,#00f2fe,#ff2c6d);
color:#fff;
font-weight:600;
text-decoration:none;
transition:.3s;
}
.contact-buttons a:hover{transform:scale(1.05);}
form input, form textarea{
width:100%;padding:12px;margin:10px 0;border-radius:10px;border:none;outline:none;
}
form button{
padding:12px 25px;background:#00f2fe;color:#000;font-weight:600;border:none;border-radius:30px;cursor:pointer;transition:.3s;
}
form button:hover{transform:scale(1.05);}
footer{
text-align:center;
padding:40px;
background:rgba(0,0,0,0.6);
}
</style>
</head>
<body>

<header>
<img src="IMG_20260219_141133.jpg" alt="Ashraf Abdalla">
